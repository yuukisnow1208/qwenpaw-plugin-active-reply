{
  "id": "active-reply",
  "name": "主动回复",
  "version": "1.0.1",
  "type": "general",
  "description": "群聊「仅 @ 回复」关闭时，未被 @ 的消息按概率选择性回复，让机器人像群友一样偶尔接话；「仅 @ 回复」开启时完全让位，只有 @ 才回复。",
  "author": "Yuukisnow",
  "entry": {
    "backend": "plugin.py",
    "frontend": "dist/index.js"
  },
  "dependencies": [],
  "qwenpaw_version": {
    "min": "2.2.0"
  },
  "meta": {
    "settings_route": "active-reply.settings",
    "api_prefix": "/api/active-reply"
  }
}
